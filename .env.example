# Optional Live Vertex AI / Gemini Configuration
# Leave unset to run in Zero-Credential Local Simulation Mode (default for PoC demos & CI).

# Mode: "auto" (uses Vertex AI if GCP vars are set, else local simulation), "vertex", or "local_sim"
GCC_POC_LLM_MODE=auto

# Google Cloud Vertex AI settings (when GCC_POC_LLM_MODE=vertex or auto with ADC)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=asia-south1
GOOGLE_GENAI_USE_VERTEXAI=true

# Optional Gemini Developer API key fallback (if not using Vertex AI ADC)
# GEMINI_API_KEY=

# Model IDs mapped to router tiers (FinOps reference rates default to Gemini 1.5 Flash / Pro)
GCC_POC_FAST_MODEL=gemini-1.5-flash
GCC_POC_PRO_MODEL=gemini-1.5-pro

# Zero-Trust Gateway Policy Settings
GCC_POC_STRICT_PII_MASKING=true
GCC_POC_MAX_ROWS_PER_CALL=15
GCC_POC_CALLER_ROLE=vertex_agent

